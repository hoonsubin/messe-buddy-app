{
	"mcpServers": {
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@0.0.38"
			],
			"alwaysAllow": [
				"browser_navigate",
				"browser_install",
				"browser_click",
				"browser_type",
				"browser_snapshot",
				"browser_resize",
				"browser_console_messages",
				"browser_take_screenshot",
				"browser_wait_for",
				"browser_tabs",
				"browser_close"
			]
		},
		"puppeteer": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-puppeteer"
			],
			"disabled": true,
			"alwaysAllow": []
		}
	}
}