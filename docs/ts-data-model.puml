@startuml diagram_06_class_data_model
title TypeScript Data Model

' ── ENUMERATIONS ───────────────────────────────────────────────
enum MissionType {
    text
    link
    form
}
enum MissionTag {
    mandatory
    needsApproval
    urgent
    overdue
}
enum ProgressStatus {
    pending
    pendingApproval
    completed
    autoApproved
}
enum ValidationMethod {
    gmApprove
    selfApprove
    qr
}
enum MilestoneStatus {
    upcoming
    inProgress
    completed
}
enum ResourceType {
    guide
    video
    link
    document
}
enum FieldType {
    text
    textarea
    select
    multiSelect
}
enum UserRole {
    player
    gamemaker
}

' ── VALUE OBJECTS ──────────────────────────────────────────────
interface FieldSchema {
    +id: string
    +label: string
    +type: FieldType
    +required: boolean
    +placeholder: string
    +options: List~string~
}
interface QRPayload {
    +playerId: string
    +missionId: string
    +sessionId: string
    +xpValue: number
    +issuedAt: number
    +hmac: string
    ' HMAC-SHA256 of (playerId+missionId+sessionId+issuedAt)
    ' keyed with session token. Verified client-side at scan time.
    ' No server call required for validation.
}
interface ChatMessage {
    +role: string
    +content: string
    +streaming: boolean
    ' role: "user" | "assistant"
    ' streaming: true while SSE chunks are still arriving
}
interface LiteLLMRequest {
    +model: string
    +messages: List~ChatMessage~
    +stream: boolean
    ' POST to VITE_LITELLM_URL/chat/completions
    ' Proxy handles model auth and policy context injection.
}
interface LegendItem {
    +label: string
    +color: string
    +status: MilestoneStatus
}
interface ScanData {
    +playerId: string
    +missionId: string
    +sessionId: string
    +xpValue: number
    +playerName: string
    +missionTitle: string
    +decodedAt: string
}
interface SessionRole {
    +userId: string
    +sessionId: string
    +role: UserRole
    +joinedAt: string
}

' ── POCKETBASE BASE ────────────────────────────────────────────
abstract class PBRecord {
    +id: string
    +created: string
    +updated: string
}

' ── PERSISTENT TYPES ───────────────────────────────────────────
class Session <<persistent>> {
    +name: string
    +bgImageUrl: string
    +gameMakerId: string
}
class Player <<persistent>> {
    +sessionId: string
    +uid: string
    +name: string
    +preferredName: string
    +pronouns: string
    +avatarUrl: string
    +role: string
    +team: string
    +startDate: string
    +location: string
    +timezone: string
    +skillsConfident: List~string~
    +skillsDevelop: List~string~
    +languages: List~string~
    +workStyle: string
    +energizers: List~string~
    +drainers: List~string~
    +profileComplete: boolean
}
class BuddyProfile <<persistent>> {
    +sessionId: string
    +assignedToPlayerId: string
    +name: string
    +role: string
    +tenure: string
    +avatarUrl: string
    +contactUrl: string
}
class Milestone <<persistent>> {
    +sessionId: string
    +name: string
    +xPercent: number
    +yPercent: number
    +xpThreshold: number
    +order: number
}
class Mission <<persistent>> {
    +sessionId: string
    +milestoneId: string
    +title: string
    +body: string
    +type: MissionType
    +validationMethod: ValidationMethod
    +externalUrl: string
    +difficulty: number
    +xpValue: number
    +tags: List~MissionTag~
    +suggestedDueDate: string
    +order: number
    +isInCurrentMissions: boolean
}
class FormSchema <<persistent>> {
    +missionId: string
    +fields: List~FieldSchema~
}
class ProgressEvent <<persistent>> {
    +sessionId: string
    +playerId: string
    +missionId: string
    +status: ProgressStatus
    +validatedBy: string
    +validatedAt: string
    +formResponse: string
}
class Resource <<persistent>> {
    +sessionId: string
    +title: string
    +type: ResourceType
    +url: string
    +isVisibleToPlayer: boolean
}

' ── EPHEMERAL TYPES ────────────────────────────────────────────
class MilestoneProgress <<ephemeral>> {
    +milestoneId: string
    +earnedXP: number
    +xpThreshold: number
    +percentComplete: number
    +status: MilestoneStatus
    +completedMissionIds: List~string~
}
class PlayerProgress <<ephemeral>> {
    +playerId: string
    +totalXP: number
    +milestoneProgress: List~MilestoneProgress~
    +completedMissionIds: List~string~
}
class ChatThread <<ephemeral>> {
    +messages: List~ChatMessage~
    +isStreaming: boolean
    ' Client-only. Never persisted to PocketBase.
    ' Reset on page navigation.
}
class DraftMission <<ephemeral>> {
    +milestoneId: string
    +isDirty: boolean
    +title: string
    +body: string
    +type: MissionType
    +externalUrl: string
    +difficulty: number
    +tags: List~MissionTag~
    +suggestedDueDate: string
}
class TemplateRecord <<ephemeral>> {
    +name: string
    +exportedAt: string
    +milestones: List~Milestone~
    +missions: List~Mission~
    +resources: List~Resource~
}

' ── PБRECORD INHERITANCE ───────────────────────────────────────
PBRecord <|-- Session
PBRecord <|-- Player
PBRecord <|-- BuddyProfile
PBRecord <|-- Milestone
PBRecord <|-- Mission
PBRecord <|-- FormSchema
PBRecord <|-- ProgressEvent
PBRecord <|-- Resource

' ── ENUM USAGE ─────────────────────────────────────────────────
FieldSchema ..> FieldType : type
LegendItem ..> MilestoneStatus : status
Mission ..> MissionType : type
Mission ..> ValidationMethod : validationMethod
ProgressEvent ..> ProgressStatus : status
Resource ..> ResourceType : type
SessionRole ..> UserRole : role
MilestoneProgress ..> MilestoneStatus : status

' ── PERSISTENT STRUCTURAL RELATIONSHIPS ───────────────────────
Session "1" --> "0..*" Milestone : owns
Session "1" --> "0..*" Player : has
Session "1" --> "0..*" Resource : includes
Session "1" --> "0..*" SessionRole : has
Session "1" --> "1" TemplateRecord : template for

Milestone "1" --> "0..*" Mission : contains
Milestone "1" --> "0..*" MilestoneProgress : tracks
Milestone "1" --> "0..*" DraftMission : drafts

Mission "1" --> "0..1" FormSchema : defines
Mission "1" --> "0..*" MissionTag : contains
FormSchema "1" *-- "1..*" FieldSchema : fields

ProgressEvent --> Player : by
ProgressEvent --> Mission : for
ProgressEvent --> Session : belongs to

BuddyProfile --> Player : assignedTo
BuddyProfile --> Session : belongs to

' ── EPHEMERAL STRUCTURAL RELATIONSHIPS ────────────────────────
PlayerProgress "1" *-- "0..*" MilestoneProgress : contains
PlayerProgress ..> ProgressEvent : derived from
PlayerProgress ..> Player : tracks

ScanData ..> QRPayload : decoded from
ScanData --> Player : for
ScanData --> ProgressEvent : creates

ChatThread "1" *-- "0..*" ChatMessage : contains
ChatThread ..> LiteLLMRequest : serialised into
LiteLLMRequest ..> ChatMessage : messages[]

DraftMission ..> Milestone : drafts of

TemplateRecord "1" *-- "0..*" Milestone : contains
TemplateRecord "1" *-- "0..*" Mission : contains
TemplateRecord "1" *-- "0..*" Resource : contains

@enduml