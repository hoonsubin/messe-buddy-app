@startuml diagram_06_class_data_model
title TypeScript Data Model (target architecture — D-ARCH-2)

' ── UNION TYPES (const object + keyof — C-12) ─────────────────
enum MissionType {
  text
  link
  form
}
enum ValidationMethod {
  gmApprove
  selfApprove
  qr
  peerScan
}
enum ProgressStatus {
  pending
  pendingApproval
  completed
  autoApproved
}
enum MilestoneStatus {
  upcoming
  inProgress
  completed
}
enum ResourceType {
  guide
  video
  link
  document
}
enum UserRole {
  player
  gamemaker
  ' CachedIdentity only — not stored on Player rows
}

' ── VALUE OBJECTS ─────────────────────────────────────────────
interface FieldSchema {
  +id: string
  +label: string
  +type: FieldType
  +required: boolean
}
interface QRPayload {
  +playerId: string
  +missionId: string
  +sessionId: string
  +xpValue: number
  +issuedAt: number
  +hmac: string
}
interface PeerScanPayload {
  +playerId: string
  +missionId: string
  +sessionId: string
  +issuedAt: number
  +hmac: string
}
interface CachedIdentity {
  +uid: string
  +recoveryKey: string
  +sessionId: string
  +role: UserRole
  +name: string
  +isDemo: boolean
}

' ── PERSISTENT TYPES ─────────────────────────────────────────
abstract class PBRecord {
  +id: string
  +created: string
  +updated: string
}

class Session <<persistent>> {
  +name: string
  +bgImageUrl: string
  +gameMakerId: string
  +gmRecoveryKey: string
  +qrSecret: string
  +preBoardingChecks: JSON
  ' GM identity — not a players row
}

class Player <<persistent>> {
  +sessionId: string
  +inviteToken: string
  +claimStatus: invited | claimed
  +uid: string
  +recoveryKey: string
  +name: string
  +jobTitle: string
  +profileComplete: boolean
  +tutorialComplete: boolean
  ' no role field — collection = player identities
}

class Milestone <<persistent>> {
  +sessionId: string
  +playerId: string
  +name: string
  +xPercent: number
  +yPercent: number
  +xpThreshold: number
  +order: number
}

class Mission <<persistent>> {
  +sessionId: string
  +playerId: string
  +milestoneId: string
  +title: string
  +body: string
  +type: MissionType
  +xpValue: number
  +validationMethod: ValidationMethod
  +peerScanTarget: number
  +order: number
  +isInCurrentMissions: boolean
}

class ProgressEvent <<persistent>> {
  +sessionId: string
  +playerId: string
  +missionId: string
  +status: ProgressStatus
  +validatedBy: string
  +validatedAt: string
  +formResponse: Record
}

class PeerScan <<persistent>> {
  +sessionId: string
  +missionId: string
  +playerId: string
  +scannerDeviceId: string
  +scannerName: string
  +formResponse: Record
}

class LibraryResource <<persistent>> {
  +resourceKey: string
  +title: string
  +description: string
  +type: ResourceType
  +url: string
  +tags: string
  ' company-wide catalog
}

class MilestoneResource <<persistent>> {
  +sessionId: string
  +playerId: string
  +milestoneId: string
  +libraryResourceId: string
  +isVisibleToPlayer: boolean
}

class FormSchema <<persistent>> {
  +missionId: string
  +fields: List~FieldSchema~
}

class TemplateRecord <<persistent>> {
  +name: string
  +data: TemplateExport
  ' global — no sessionId
}

class TemplateExport <<ephemeral export>> {
  +milestones: List
  +missions: List
  +formSchemas: List
  +resourceBindings: List
  ' milestoneOrder + resourceKey
}

' ── EPHEMERAL (client-only) ────────────────────────────────────
class DraftMilestone <<ephemeral>> {
  +id: string
  +name: string
  +xPercent: number
  +yPercent: number
  +isDirty: boolean
}

class DraftMission <<ephemeral>> {
  +milestoneId: string
  +xpValue: number
  +isDirty: boolean
}

class MilestoneProgress <<ephemeral>> {
  +milestoneId: string
  +earnedXP: number
  +xpThreshold: number
  +percentComplete: number
  +status: MilestoneStatus
}

class PlayerProgress <<ephemeral>> {
  +playerId: string
  +totalXP: number
  +milestoneProgress: List~MilestoneProgress~
}

' ── RELATIONSHIPS ──────────────────────────────────────────────
PBRecord <|-- Session
PBRecord <|-- Player
PBRecord <|-- Milestone
PBRecord <|-- Mission
PBRecord <|-- ProgressEvent
PBRecord <|-- PeerScan
PBRecord <|-- LibraryResource
PBRecord <|-- MilestoneResource
PBRecord <|-- FormSchema
PBRecord <|-- TemplateRecord

Session "1" --> "0..*" Player : onboarding identities
Session "1" --> "0..*" Milestone : via player journeys
Player "1" --> "0..*" Milestone
Milestone "1" --> "0..*" Mission
Mission "1" --> "0..1" FormSchema
Mission "1" --> "0..*" PeerScan
Milestone "1" --> "0..*" MilestoneResource
LibraryResource "1" --> "0..*" MilestoneResource
ProgressEvent --> Mission
PlayerProgress ..> ProgressEvent : derived (C-11)
TemplateExport ..> LibraryResource : resourceKey bindings
TemplateRecord --> TemplateExport : data JSON

note bottom of Player
  invitePlayer → invited row
  claimPlayer → uid + recoveryKey
  UserRole.player only in CachedIdentity
end note

@enduml
