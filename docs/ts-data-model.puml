@startuml diagram_06_class_data_model
title TypeScript Data Model (target architecture)

' ── UNION TYPES (const object + keyof — C-12) ─────────────────
enum MissionType {
  text
  link
  form
}
enum ValidationMethod {
  gmApprove
  selfApprove
  qr
  peerScan
}
enum ProgressStatus {
  pending
  pendingApproval
  completed
  autoApproved
}
enum MilestoneStatus {
  upcoming
  inProgress
  completed
}
enum ResourceType {
  guide
  video
  link
  document
}
enum UserRole {
  player
  gamemaker
}

' ── VALUE OBJECTS ─────────────────────────────────────────────
interface FieldSchema {
  +id: string
  +label: string
  +type: FieldType
  +required: boolean
}
interface QRPayload {
  +playerId: string
  +missionId: string
  +sessionId: string
  +xpValue: number
  +issuedAt: number
  +hmac: string
  ' GM validation QR only (validationMethod = qr)
}
interface PeerScanPayload {
  +playerId: string
  +missionId: string
  +sessionId: string
  +issuedAt: number
  +hmac: string
  ' Crowd attestation QR (validationMethod = peerScan)
}
interface CachedIdentity {
  +uid: string
  +recoveryKey: string
  +sessionId: string
  +role: UserRole
  +name: string
  +isDemo: boolean
}

' ── PERSISTENT TYPES ─────────────────────────────────────────
abstract class PBRecord {
  +id: string
  +created: string
  +updated: string
}

class Session <<persistent>> {
  +name: string
  +bgImageUrl: string
  +gameMakerId: string
  +qrSecret: string
  +preBoardingChecks: JSON
}

class Player <<persistent>> {
  +uid: string
  +recoveryKey: string
  +sessionId: string
  +name: string
  +preferredName: string
  +profileComplete: boolean
  +tutorialComplete: boolean
  ' ... profile fields
}

class Milestone <<persistent>> {
  +sessionId: string
  +name: string
  +xPercent: number
  +yPercent: number
  +xpThreshold: number
  +order: number
  ' xpThreshold = sum(missions.xpValue) in milestone
}

class Mission <<persistent>> {
  +sessionId: string
  +milestoneId: string
  +title: string
  +body: string
  +type: MissionType
  +xpValue: number
  ' **GM-set directly — no difficulty field**
  +validationMethod: ValidationMethod
  +peerScanTarget: number
  ' required when validationMethod = peerScan
  +order: number
  +isInCurrentMissions: boolean
}

class ProgressEvent <<persistent>> {
  +sessionId: string
  +playerId: string
  +missionId: string
  +status: ProgressStatus
  +validatedBy: string
  +validatedAt: string
  +formResponse: Record
}

class PeerScan <<persistent>> {
  +sessionId: string
  +missionId: string
  +playerId: string
  +scannerDeviceId: string
  +scannerName: string
  +formResponse: Record
  ' unique (missionId, playerId, scannerDeviceId)
}

class Resource <<persistent>> {
  +sessionId: string
  +title: string
  +type: ResourceType
  +url: string
  +isVisibleToPlayer: boolean
  ' session-scoped QoL — no missionId FK
}

class FormSchema <<persistent>> {
  +missionId: string
  +fields: List~FieldSchema~
}

class TemplateExport <<ephemeral export>> {
  +milestones: List
  +missions: List
  +formSchemas: List
  +resources: List
}

' ── EPHEMERAL (client-only) ────────────────────────────────────
class DraftMilestone <<ephemeral>> {
  +id: string
  +name: string
  +xPercent: number
  +yPercent: number
  +isDirty: boolean
}

class DraftMission <<ephemeral>> {
  +milestoneId: string
  +xpValue: number
  +isDirty: boolean
  ' ... editable mission fields
}

class MilestoneProgress <<ephemeral>> {
  +milestoneId: string
  +earnedXP: number
  +xpThreshold: number
  +percentComplete: number
  +status: MilestoneStatus
}

class PlayerProgress <<ephemeral>> {
  +playerId: string
  +totalXP: number
  +milestoneProgress: List~MilestoneProgress~
}

' ── RELATIONSHIPS ──────────────────────────────────────────────
PBRecord <|-- Session
PBRecord <|-- Player
PBRecord <|-- Milestone
PBRecord <|-- Mission
PBRecord <|-- ProgressEvent
PBRecord <|-- PeerScan
PBRecord <|-- Resource
PBRecord <|-- FormSchema

Session "1" --> "0..*" Milestone
Session "1" --> "0..1" Player : hire player slot
Session "1" --> "0..*" Resource : QoL
Milestone "1" --> "0..*" Mission
Mission "1" --> "0..1" FormSchema
Mission "1" --> "0..*" PeerScan : peerScan validations
ProgressEvent --> Mission : completion per player
PlayerProgress ..> ProgressEvent : derived (C-11)
PlayerProgress ..> Mission : sums xpValue

note bottom of Mission
  Templates round-trip full mission config
  including validationMethod, xpValue,
  peerScanTarget, and linked FormSchema.
end note

@enduml
