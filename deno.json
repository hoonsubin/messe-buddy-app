{
  "tasks": {
    "dev": "deno run -A npm:vite -- --host",
    "build": "deno run -A npm:typescript/bin/tsc -b && deno run -A npm:vite build",
    "lint": "deno run -A npm:eslint .",
    "preview": "deno run -A npm:vite preview -- --host",
    "smoke-landing": "deno run -A --node-modules-dir=auto scripts/smoke-landing.ts",
    "smoke-e2e": "deno run -A --node-modules-dir=auto scripts/smoke-e2e.ts",
    "smoke-pb-phase1": "deno run -A --node-modules-dir=auto scripts/smoke-pb-phase1.ts",
    "smoke-pb-phase2": "deno run -A --node-modules-dir=auto scripts/smoke-pb-phase2.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "types": ["react", "react-dom", "@types/react", "vite/client"],
    "lib": ["dom", "dom.iterable", "deno.ns", "ES2024"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "fmt": {
    "include": ["src/"],
    "exclude": ["src/testdata/", "src/generated/**/*.ts", "src/**/*.css"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "imports": {
    "react": "npm:react@^19.2.6",
    "react-dom": "npm:react-dom@^19.2.6",
    "react-icons": "npm:react-icons@^5.6.0",
    "react-router-dom": "npm:react-router-dom@^7.6.2",
    "pocketbase": "npm:pocketbase@^0.27.0",
    "qrcode": "npm:qrcode@^1.5.4",
    "jsqr": "npm:jsqr@^1.4.0",
    "marked": "npm:marked@^15.0.12",
    "@types/qrcode": "npm:@types/qrcode@^1.5.5",
    "@eslint/js": "npm:@eslint/js@^10.0.1",
    "@std/fs": "https://deno.land/std@0.208.0/fs/mod.ts",
    "@types/node": "npm:@types/node@^24.12.3",
    "@types/react": "npm:@types/react@^19.2.14",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.1",
    "eslint": "npm:eslint@^10.3.0",
    "eslint-plugin-react-hooks": "npm:eslint-plugin-react-hooks@^7.1.1",
    "eslint-plugin-react-refresh": "npm:eslint-plugin-react-refresh@^0.5.2",
    "globals": "npm:globals@^17.6.0",
    "typescript": "npm:typescript@~6.0.2",
    "typescript-eslint": "npm:typescript-eslint@^8.59.2",
    "vite": "npm:vite@^8.0.12"
  }
}
