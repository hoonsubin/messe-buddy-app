# MesseBuddy — Environment Variables
#
# Copy this file to .env and fill in the values before running docker compose.
# .env is gitignored — never commit secrets.

# ── LiteLLM Proxy ──────────────────────────────────────────────────────────────

# Master key for LiteLLM management endpoints (/health, /model/info, etc.)
# The useChatStream hook uses this as the Bearer token in Authorization headers.
# Change this in any shared or production environment.
LITELLM_MASTER_KEY=sk-dev-change-in-production

# LLM provider API keys — add whichever provider is configured in litellm.yaml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=

# ── Build args (optional overrides) ────────────────────────────────────────────
# These are baked into the PWA JS bundle at Docker build time.
# Only set these if you're deploying to a non-localhost environment.
# VITE_PB_URL=http://localhost:8090
# VITE_LITELLM_URL=http://localhost:4000

# ── App port ───────────────────────────────────────────────────────────────────
# Port the nginx PWA container binds on the host. Defaults to 80.
# APP_PORT=80

# ── PocketBase version ─────────────────────────────────────────────────────────
# Override the PocketBase binary version used in the Docker build.
# PB_VERSION=0.23.0

# ── PostgreSQL + pgvector (unified database) ───────────────────────────────────
# Single PostgreSQL instance with the pgvector extension.
# Serves BOTH LiteLLM metadata (virtual keys, spend, model configs) AND
# the RAG vector store for document embeddings.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme
# Host port the PostgreSQL container binds on. Comment out for production
# to avoid exposing the database port externally.
# POSTGRES_PORT=5432

# ── LiteLLM Admin UI ────────────────────────────────────────────────────────────
# Credentials for the LiteLLM Admin UI (http://localhost:4000/ui).
UI_USERNAME=admin
# UI_PASSWORD defaults to LITELLM_MASTER_KEY when not set.

# ── Redis (LiteLLM cache / rate-limit state) ────────────────────────────────────
REDIS_PASSWORD=changeme

# ── RAG tuning ─────────────────────────────────────────────────────────────────
# Embedding model used for both document ingestion and query-time retrieval.
# Must be the same model in both places or similarity scores will be meaningless.
EMBEDDING_MODEL=text-embedding-3-small
# Number of document chunks to retrieve per query
RAG_TOP_K=5
# Cosine similarity threshold (0–1). Chunks below this are ignored.
# Lower = more permissive (may include off-topic chunks).
# Higher = stricter (may refuse valid questions if documents are thin).
RAG_MIN_SIMILARITY=0.70
