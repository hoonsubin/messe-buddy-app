# MesseBuddy - Environment Variables
# Copy to .env, fill in secrets. Gitignored — never commit.

LLM_SERVER_API_KEY=
LITELLM_MASTER_KEY=sk-change-me-in-prod

VITE_PB_URL=/
VITE_USE_MOCK_PB=true
VITE_LITELLM_URL=http://localhost:4000
VITE_LITELLM_MODEL=policy-assistant
# NOTE: VITE_LITELLM_PROXY_KEY is NOT set here. `docker compose up` injects the
# messebuddy-pwa virtual key at container runtime (entrypoint.sh + nginx /llm
# proxy), minted by file-watcher after this image is built. Only set manually
# for a `docker build` outside docker-compose (dev/escape-hatch).
VITE_LITELLM_PROXY_KEY=
# NOTE: VITE_PB_URL is hardcoded to "/" in docker-compose.yml (same-origin nginx proxy).
# For split-host deployment, override with:
#   docker compose build --build-arg VITE_PB_URL=https://your-domain.com

PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
PB_AUTO_MIGRATE=true

APP_PORT=80
APP_HTTPS_PORT=443

# ── Public HTTPS (automated Let's Encrypt via the `certbot` service) ───────────
# Leave both blank for local/LAN dev — nginx falls back to server_name "_" and
# a self-signed cert (browser click-through warning), same as before.
#
# For a public deployment: point PUBLIC_DOMAIN's DNS A record at the host
# first, make sure ports 80 + 443 are reachable from the internet (80 is
# needed for the HTTP-01 challenge, not just as a UX nicety), then set:
PUBLIC_DOMAIN=
CERTBOT_EMAIL=
# `docker compose up -d` after that is enough — the certbot service issues
# the cert on first boot and renews automatically. No nginx.conf edits, no
# manual cert copying, no rebuild. Changing PUBLIC_DOMAIN later and
# restarting re-issues for the new domain — nothing else to touch.

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme
# Comment out to avoid exposing externally in production.
POSTGRES_PORT=5432

POSTGRES_VECTOR_DB=litellm_vector

LITELLM_UI_USERNAME=admin

GEMINI_API_KEY=

EMBEDDING_MODEL=gemini-embedding-2
# Gemini Embedding 2 natively outputs 3072 dims but is MRL-trained, so it can
# be truncated to 768 or 1536 with well-characterized (published) quality
# loss. 1536 is the balance point: indexable under pgvector's 2000-dim
# ivfflat/hnsw ceiling, near-full retrieval quality, half the storage/compute
# of 3072. This value is NOT just documentation — it's sent as the actual
# `dimensions` param on every /v1/embeddings call (see
# docker/file-watcher/watcher.py and docker/litellm-pgvector/embedding_service.py)
# AND must match the fixed vector(N) column in
# docker/litellm-pgvector/prisma/schema.prisma. Changing this value requires
# also editing schema.prisma and wiping the vector_db_data volume — existing
# rows can't be cast to a different dimension.
EMBEDDING_DIM=1536

CHUNK_SIZE=1500
OVERLAP=150

RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=30
