# MesseBuddy - Environment Variables
#
# Copy this file to .env, fill in secrets, then run: docker compose up --build
# .env is gitignored - never commit secrets.

# -- Required (no defaults) --
# LLM API key for embeddings + chat + reranker
LLM_SERVER_API_KEY=

# -- LiteLLM management --
# Proxy management (health, keys, config). Also used as pgvector connector key.
LITELLM_MASTER_KEY=sk-change-me-in-prod

# -- Build args (baked into the PWA JS bundle at docker build time) --
# Override these for non-localhost deployments. See AGENTS.md for details.
# NOTE: VITE_LITELLM_KEY is NOT set here. `docker compose up` injects the
# messebuddy-pwa virtual key at container runtime (entrypoint.sh + nginx /llm
# proxy), minted by init-vector-store after this image is built. Only set
# VITE_LITELLM_KEY manually for a `docker build` outside docker-compose
# (e.g. a direct-from-browser dev/escape-hatch build).
# NOTE: VITE_PB_URL is hardcoded to "/" in docker-compose.yml (same-origin
# nginx proxy) and is NOT read from this file via `docker compose up --build`.
# For a split-host deployment, override it with an explicit
# `docker compose build --build-arg VITE_PB_URL=https://your-domain.com`.
# Same-origin (SDK appends /api); http://127.0.0.1:8090 for direct local PB
VITE_PB_URL=/
# "false" in production → real PB adapter
VITE_USE_MOCK_PB=true
VITE_LITELLM_URL=http://localhost:4000
VITE_LITELLM_MODEL=policy-assistant

# -- PocketBase --
# Superuser email for Admin UI (optional; created via auto-migration if set)
PB_ADMIN_EMAIL=
# Superuser password for Admin UI (optional; created via auto-migration if set)
PB_ADMIN_PASSWORD=
# "false" after initial deploy to prevent re-migration
PB_AUTO_MIGRATE=true

# -- App container ports (host-side) --
# Host port → nginx :80 (HTTP)
APP_PORT=80
# Host port → nginx :443 (HTTPS)
APP_HTTPS_PORT=443

# -- PostgreSQL (LiteLLM metadata) --
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme
# Host port. Comment out to avoid exposing externally in production.
POSTGRES_PORT=5432

# -- PostgreSQL (Vector store for RAG) --
# vector-db reuses POSTGRES_USER / POSTGRES_PASSWORD above (same role, separate DB).
POSTGRES_VECTOR_DB=litellm_vector

# -- LiteLLM Admin UI --
# Password defaults to LITELLM_MASTER_KEY
LITELLM_UI_USERNAME=admin

# -- RAG Embedding --
# Must match a model_name in docker/litellm.yaml
EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_DIM=768

# -- RAG Chunking --
# Char-based (no token counting). Keep CHUNK_SIZE comfortably under the
# embedding server's context window in tokens - dense text can run well
# above 4 chars/token. Sized for nomic-embed-text-v1.5 on llama.cpp at a
# 2048-token context (LLAMA_ARG_CTX_SIZE).
CHUNK_SIZE=2800
OVERLAP=280

# -- RAG Reranking --
# "false" → plain vector-similarity order
RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
# Pool size before reranking
RERANK_CANDIDATES=30
