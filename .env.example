# MesseBuddy - Environment Variables
#
# Copy this file to .env, fill in secrets, then run: docker compose up --build
# .env is gitignored - never commit secrets.

# -- Required (no defaults) --
LLM_PROXY_KEY=                                          # LLM API key for embeddings + chat + reranker

# -- LiteLLM management --
LITELLM_MASTER_KEY=sk-change-me-in-prod                  # Proxy management (health, keys, config). Also used as pgvector connector key.

# -- Build args (baked into the PWA JS bundle at docker build time) --
# Override these for non-localhost deployments. See AGENTS.md for details.
VITE_PB_URL=/                                           # Same-origin (SDK appends /api); http://127.0.0.1:8090 for direct local PB
VITE_USE_MOCK_PB=true                                   # "false" in production → real PB adapter
VITE_LITELLM_URL=http://localhost:4000
VITE_LITELLM_KEY=                                       # Scoped virtual key (bundle-visible). Empty = mock chat.
VITE_LITELLM_MODEL=policy-assistant
VITE_USE_MOCK_CHAT=true                                 # "false" + valid VITE_LITELLM_KEY → live AI streaming

# -- PocketBase --
PB_ADMIN_EMAIL=                                         # Superuser email for Admin UI (optional; created via auto-migration if set)
PB_ADMIN_PASSWORD=                                      # Superuser password for Admin UI (optional; created via auto-migration if set)
PB_AUTO_MIGRATE=true                                    # "false" after initial deploy to prevent re-migration

# -- PostgreSQL (LiteLLM metadata) --
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432                                      # Host port. Comment out to avoid exposing externally in production.

# -- PostgreSQL (Vector store for RAG) --
POSTGRES_VECTOR_DB=litellm_vector
POSTGRES_VECTOR_USER=litellm_vector
POSTGRES_VECTOR_PASSWORD=changeme

# -- LiteLLM Admin UI --
UI_USERNAME=admin                                       # Password defaults to LITELLM_MASTER_KEY

# -- Redis --
REDIS_PASSWORD=changeme

# -- RAG Embedding --
EMBEDDING_MODEL=nomic-embed-text-v2-moe                 # Must match a model_name in docker/litellm.yaml
EMBEDDING_DIM=768

# -- RAG Reranking --
RERANK_ENABLED=true                                     # "false" → plain vector-similarity order
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=30                                    # Pool size before reranking
