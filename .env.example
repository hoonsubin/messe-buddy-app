# MesseBuddy - Environment Variables
# Copy to .env, fill in secrets. Gitignored — never commit.

LLM_SERVER_API_KEY=
LITELLM_MASTER_KEY=sk-change-me-in-prod

VITE_PB_URL=/
VITE_USE_MOCK_PB=true
VITE_LITELLM_URL=http://localhost:4000
VITE_LITELLM_MODEL=policy-assistant
# NOTE: VITE_LITELLM_PROXY_KEY is NOT set here. `docker compose up` injects the
# messebuddy-pwa virtual key at container runtime (entrypoint.sh + nginx /llm
# proxy), minted by file-watcher after this image is built. Only set manually
# for a `docker build` outside docker-compose (dev/escape-hatch).
VITE_LITELLM_PROXY_KEY=
# NOTE: VITE_PB_URL is hardcoded to "/" in docker-compose.yml (same-origin nginx proxy).
# For split-host deployment, override with:
#   docker compose build --build-arg VITE_PB_URL=https://your-domain.com

PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
PB_AUTO_MIGRATE=true

APP_PORT=80
APP_HTTPS_PORT=443

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme
# Comment out to avoid exposing externally in production.
POSTGRES_PORT=5432

POSTGRES_VECTOR_DB=litellm_vector

LITELLM_UI_USERNAME=admin

GEMINI_API_KEY=

EMBEDDING_MODEL=gemini-embedding-2
# Gemini Embedding 2 outputs 3072-dim vectors by default (MRL-supported)
EMBEDDING_DIM=3072

CHUNK_SIZE=1500
OVERLAP=150

RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=30
