# MesseBuddy - Environment Variables
#
# Copy this file to .env and fill in the values before running docker compose.
# .env is gitignored - never commit secrets.

# ── LiteLLM Proxy ──────────────────────────────────────────────────────────────

# Master key for LiteLLM management endpoints (/health, /model/info, etc.)
# The useChatStream hook uses this as the Bearer token in Authorization headers.
# Also used as the API key for the pgvector connector service.
# Change this in any shared or production environment.
LITELLM_MASTER_KEY=sk-change-me-in-prod

# LLM provider API keys - add whichever provider is configured in litellm.yaml
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=

# ── HoonLabs LiteLLM Proxy ────────────────────────────────────────────────────
# API key for the upstream LiteLLM proxy at https://litellm.hoonlabs.xyz
# Used for: embedding (nomic-embed-text-v2-moe), chat (deepseek-v4-flash,
# ibm-granite-tiny), and reranker (bge-reranker-v2-m3) models.
LLM_PROXY_KEY=

# ── Build args (optional overrides) ────────────────────────────────────────────
# These are baked into the PWA JS bundle at Docker build time.
# Only set these if you're deploying to a non-localhost environment.
VITE_PB_URL=http://localhost:8090
VITE_LITELLM_URL=http://localhost:4000

# ── AI assistant (chat) ─────────────────────────────────────────────────────────
# The PWA calls LiteLLM's OpenAI-compatible endpoint directly from the browser,
# so this key is PUBLICLY VISIBLE in the bundle. Use a scoped, budget-capped
# LiteLLM *virtual key* (Admin UI → Keys) - never the master key. Closed
# prototype/demo only.
VITE_LITELLM_KEY=
# Model alias routed by the proxy (docker/litellm.yaml → model_name).
VITE_LITELLM_MODEL=policy-assistant
# Chat data source: "true" (default) uses the built-in mock responses so the app
# runs with no key. Set to "false" - with a valid VITE_LITELLM_KEY - for the live
# streaming endpoint.
VITE_USE_MOCK_CHAT=true

# ── App port ───────────────────────────────────────────────────────────────────
# Port the nginx PWA container binds on the host. Defaults to 80.
APP_PORT=80

# ── PocketBase version ─────────────────────────────────────────────────────────
# Override the PocketBase binary version used in the Docker build.
PB_VERSION=0.23.0

# ── litellm-db (LiteLLM metadata) ────────────────────────────────────────────────
# Stores virtual keys, spend logs, model configurations, API key management,
# and team/org settings for the LiteLLM proxy.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme
# Host port the PostgreSQL container binds on. Comment out for production
# to avoid exposing the database port externally.
POSTGRES_PORT=5432

# ── vector-db (Vector store for RAG) ──────────────────────────────────────────────
# Dedicated database for the litellm-pgvector connector.
# Stores only the vector_stores and embeddings tables - no LiteLLM metadata.
# Separated to prevent Prisma db push conflicts with LiteLLM's own migrations.
POSTGRES_VECTOR_DB=litellm_vector
POSTGRES_VECTOR_USER=litellm_vector
POSTGRES_VECTOR_PASSWORD=changeme

# ── LiteLLM Admin UI ────────────────────────────────────────────────────────────
# Credentials for the LiteLLM Admin UI (http://localhost:4000/ui).
UI_USERNAME=admin
# UI_PASSWORD defaults to LITELLM_MASTER_KEY when not set.

# ── Redis (LiteLLM cache / rate-limit state) ────────────────────────────────────
REDIS_PASSWORD=changeme

# ── RAG / Embedding ────────────────────────────────────────────────────────────
# Embedding model used for document ingestion and query-time retrieval.
# Must match a model_name registered in docker/litellm.yaml.
# Default: nomic-embed-text-v2-moe (768-dim Matryoshka MoE, via HoonLabs proxy)
EMBEDDING_MODEL=nomic-embed-text-v2-moe
# Embedding dimension (768 for nomic-embed-text-v2-moe, 1536 for text-embedding-3-small)
EMBEDDING_DIM=768

# ── Reranking (RAG cross-encoder) ───────────────────────────────────────────────
# The pgvector connector over-fetches a candidate pool, reranks it with a
# cross-encoder, then returns the top results for prompt injection.
# RERANK_MODEL must match a rerank-capable model_name in docker/litellm.yaml
# (registered with the hosted_vllm/ provider, which exposes /rerank).
# Set RERANK_ENABLED=false to use plain vector-similarity order.
RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
# Candidate pool size pulled from vector search before reranking down to top-k.
RERANK_CANDIDATES=30
